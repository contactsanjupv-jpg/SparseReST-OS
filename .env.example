# Copy to .env and adjust. See docs/ENVIRONMENT.md for what each variable does.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sparserest_dev
APP_DATABASE_URL=postgresql+psycopg://app_role:change_me_in_env@localhost:5432/sparserest_dev

# Optional -- omit to run with $0 cost against FakeLLMClient (deterministic, no network calls)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_STRONG=claude-opus-5

# Optional -- omit to run with LoggingOutreachProvider (never sends real email)
OUTREACH_PROVIDER_API_KEY=
OUTREACH_PROVIDER_WEBHOOK_SECRET=

# Optional -- omit to run with ConsoleNotifier (incidents are recorded, but nobody is paged)
SLACK_WEBHOOK_URL=

# Optional -- omit to run the API open (localhost-only dev use)
FOUNDER_API_KEY=

# Tool wiring -- 'stub' everywhere by default ($0, deterministic, no network,
# what every test relies on). See docs/ENVIRONMENT.md for what each real
# mode needs and how to smoke-test it yourself once running locally.
ENRICHMENT_MODE=stub
OUTREACH_MODE=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_DAILY_SEND_CAP=30

# Optional -- omit to leave inbound reply checking off (classify replies
# manually via the API instead). Falls back to SMTP_USERNAME/SMTP_PASSWORD
# when not set separately.
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# ---- Secrets: any credential below may be a reference instead of a literal --------------------------------
#   SMTP_PASSWORD=secret://smtp_password          (stored encrypted:  python -m scripts.secrets_cli set smtp_password)
#   ANTHROPIC_API_KEY=file:///run/secrets/anthropic_key
# DATABASE_URL / APP_DATABASE_URL may use file:// only (they are needed to reach the store itself).
SECRETS_MASTER_KEY_FILE=
SECRETS_MASTER_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=auto

# ---- API hardening (REQUIRED to change for production) ----------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=1000000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_LOGIN_IN_PRODUCTION=true

# ---- Acquisition engine (see docs/RUNBOOK.md) -------------------------------------------------------------
DNS_VALIDATION=true
OUTBOUND_HARD_CEILING=30
REPORT_EMAIL_TO=
APPROVAL_REMINDER_HOURS=12
HOT_LEAD_SLA_HOURS=4

# ---- Mailbox TLS (certificates are VERIFIED by default) ------------------------------------------------------
TLS_CA_FILE=
ALLOW_INSECURE_TLS=false

# ---- Workers ----------------------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_STALE_AFTER_SECONDS=60
INBOUND_POLL_INTERVAL_SECONDS=60
MAINTENANCE_INTERVAL_SECONDS=300
